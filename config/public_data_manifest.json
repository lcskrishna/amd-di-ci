{
  "schema_version": 1,
  "policy": "The site assembler publishes only the files listed here. Every other file under data/ is private collector input, state, cache, or a retired artifact.",
  "required_files": [
    "site/projects.json",
    "users.json",
    "vllm/ci/amd_test_matrix.json",
    "vllm/ci/analytics.json",
    "vllm/ci/capacity_monitor.json",
    "vllm/ci/ci_health.json",
    "vllm/ci/config_parity.json",
    "vllm/ci/failure_trends.json",
    "vllm/ci/flaky_tests.json",
    "vllm/ci/gating_nightlies.json",
    "vllm/ci/gating_proposals.json",
    "vllm/ci/gating_target_candidates.json",
    "vllm/ci/gating_targets.json",
    "vllm/ci/group_changes.json",
    "vllm/ci/hotness.json",
    "vllm/ci/omni_surge_heuristic.json",
    "vllm/ci/parity_report.json",
    "vllm/ci/project_items.json",
    "vllm/ci/queue_jobs.json",
    "vllm/ci/queue_lifecycle.json",
    "vllm/ci/queue_timeseries.jsonl",
    "vllm/ci/ready_tickets.json",
    "vllm/ci/shard_bases.json",
    "vllm/ci/test_builds/index.json",
    "vllm/ci/workload_mapping.json",
    "vllm/di/grid.json",
    "vllm/issues.json",
    "vllm/parity_report.json",
    "vllm/perf_eval/perf_eval.json",
    "vllm/prs.json",
    "vllm/releases.json",
    "vllm/test_results.json"
  ],
  "optional_files": [
    "vllm/ci/engineers.enc.json",
    "vllm/ci/kill_auth.enc.json"
  ],
  "build_inputs": [
    "vllm/ci/operations_v2.json"
  ],
  "optional_globs": [
    "vllm/ci/test_builds/*/comparison.json"
  ],
  "generated_files": [
    "vllm/ci/operations_v2_manifest.json",
    "vllm/ci/queue_history_chart.json",
    "vllm/ci/operations_v2/amd_agent_health.json",
    "vllm/ci/operations_v2/amd_test_health.json",
    "vllm/ci/operations_v2/definition_parity.json",
    "vllm/ci/operations_v2/diagnostics.json",
    "vllm/ci/operations_v2/gating.json",
    "vllm/ci/operations_v2/nightly.json",
    "vllm/ci/operations_v2/omni.json",
    "vllm/ci/operations_v2/ownership.json",
    "vllm/ci/operations_v2/queue.json",
    "vllm/ci/operations_v2/reliability.json",
    "vllm/ci/operations_v2/trajectory.json"
  ],
  "never_publish_patterns": [
    "*/.cache/*",
    "vllm/ci/agent_health/*",
    "vllm/ci/test_results/*",
    "vllm/di/test_results/*",
    "vllm/di/jobs.jsonl",
    "vllm/ci/test_builds/*/results.jsonl",
    "vllm/perf_eval/events.jsonl",
    "vllm/ci/open_*_issues.json",
    "vllm/ci/*_state.json",
    "vllm/ci/agent_health.json",
    "vllm/ci/operations_v2.json",
    "vllm/ci/last_collected_at.txt",
    "vllm/ci/parity_key_overrides.json",
    "vllm/ci/quarantine.json",
    "vllm/ci/queue_lifecycle_jobs/*"
  ]
}
